{
    "name": "kafyx-3/laravel-datatables-export",
    "description": "CDN DataTables v2 + tombol Export (Copy, CSV, Excel, PDF, Print) untuk Laravel — tanpa jQuery, satu tag Blade di layout, langsung jalan.",
    "type": "library",
    "keywords": ["laravel", "datatables", "datatables-export", "export", "csv", "excel", "pdf", "print", "blade", "component", "cdn"],
    "license": "MIT",
    "authors": [
        {
            "name": "kafyx-3",
            "homepage": "https://github.com/kafyx-3/datatables-push"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kafyx3\\DataTablesExport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kafyx3\\DataTablesExport\\DataTablesExportServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
